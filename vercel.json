{
  "crons": [
    {
      "path": "/api/cron/sevens",
      "schedule": "0 9 * * *"
    }
  ],
  "functions": {
    "api/tags.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/|assets/|icons/|sw\\.js|manifest\\.webmanifest|registerSW\\.js|workbox-).*)",
      "destination": "/index.html"
    }
  ]
}
